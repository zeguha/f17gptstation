# Copy this file to `.env` for local development. Never commit real `.env` files.

# ---- Cloud provider ----
CLOUD_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=gpt-4o-transcribe
# Optional: vocabulary hint for STT to reduce misrecognition of domain words
# (e.g. "плейлист" being split/misheard). Leave unset to use the built-in
# default in assistant/config.py, or override with your own playlist/artist
# names that keep getting misheard, comma-separated.
# OPENAI_STT_PROMPT=Плейлист, Spotify, трек, Грустинка, Вечерний чилл
OPENAI_LLM_MODEL=gpt-5-search-api
OPENAI_LLM_TEMPERATURE=default
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_SEC=25

# Optional legacy Groq chat client (`assistant/chat.py`).
GROQ_API_KEY=replace-with-your-groq-api-key

# ---- Audio ----
INPUT_DEVICE=
OUTPUT_DEVICE=
SAMPLE_RATE=16000
FRAME_MS=30
# Digital pre-amp for captured mic audio (1.0 = unchanged). Raise this if
# your mic has no hardware capture-level control and quiet speech (e.g. a
# barge-in "стоп" said over TTS playback) isn't registering reliably.
INPUT_GAIN=1.0
PLAYBACK_SR=24000
SUPPRESS_MIC_DURING_TTS=false

# ---- Wake/VAD/dialog ----
WAKE_PHRASE=олег
WAKE_MATCH_THRESHOLD=0.60
WAKE_MIN_SPEECH_RATIO=0.10
# Minimum average per-word ASR confidence (0..1) to accept a wake match. Raise
# this if short/common wake phrases (e.g. a real name) false-trigger on
# background TV/music/dialogue.
WAKE_MIN_CONF=0.70
WAKE_TAIL_DROP_MS=250
WAKE_COOLDOWN_SEC=1.0
COMMAND_START_TIMEOUT_SEC=5.0
MAX_SILENCE_SEC=0.8
MAX_PHRASE_SEC=12.0
MIN_PHRASE_SEC=0.35
SYSTEM_PROMPT=Ты голосовой ассистент. Отвечай кратко, по делу, на русском языке.
MAX_CONTEXT_TURNS=6
ENABLE_STOP_WORD=true
STOP_WORDS=стоп,хватит,отмена
STOP_WORD_COOLDOWN_SEC=1.0

# ---- Reliability ----
CLOUD_MAX_IN_FLIGHT=2
CLOUD_MAX_ATTEMPTS=3
CLOUD_BASE_DELAY_SEC=0.4
CLOUD_MAX_DELAY_SEC=6.0

# ---- Weather ----
WEATHER_ENABLED=true
GEO_MODE=auto
GEO_FIXED_LAT=
GEO_FIXED_LON=
IP_GEO_URL=https://ipapi.co/json/
WEATHER_PROVIDER=open-meteo
GEO_TIMEOUT_SEC=4.0
WEATHER_TIMEOUT_SEC=6.0
GEO_CACHE_TTL_SEC=43200
WEATHER_CACHE_TTL_SEC=300
WEATHER_UNITS=metric

# ---- Spotify ----
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:17845/callback
SPOTIFY_TOKEN_PATH=.secrets/spotify_tokens.json
SPOTIFY_PREFERRED_DEVICE=

# ---- Lights / WiZ LAN ----
LIGHTS_ENABLED=true
GAUSS_ADAPTER=wiz_lan
LIGHTS_STATE_PATH=.state/lights.json
LIGHTS_REQUEST_TIMEOUT_SEC=4.0
LIGHTS_STATE_CACHE_TTL_SEC=6.0
LIGHTS_DEFAULT_SCOPE=room
LIGHTS_DEFAULT_ROOM=
WIZ_IPS=
WIZ_BROADCAST_ADDR=
WIZ_LOCAL_IP=

# ---- Local ASR / whisper.cpp ----
VOSK_MODEL_PATH=assistant/models/vosk-model-ru
ASR_BACKEND=vosk
WHISPER_BIN=whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=whisper.cpp/models/ggml-small.bin

# ---- Logging ----
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_ROUTE_DEBUG=false
