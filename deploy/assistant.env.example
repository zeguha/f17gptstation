# /etc/assistant.env
# Copy this file to the Raspberry Pi as /etc/assistant.env and edit locally.
# Do not commit real values.

# ---- Cloud (OpenAI default) ----
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_STT_MODEL=gpt-4o-transcribe
# LLM:
# - cheap default: gpt-4o-mini
# - set another supported model if needed.
OPENAI_LLM_MODEL=gpt-5-search-api
# Some models do not support custom temperature.
# Use "default" to omit the temperature parameter.
OPENAI_LLM_TEMPERATURE=default
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---- Audio ----
# INPUT_DEVICE is usually required on Raspberry Pi.
INPUT_DEVICE=1
# OUTPUT_DEVICE=

# If True, mic input is ignored while TTS is playing.
# WARNING: this disables stop-word during playback.
SUPPRESS_MIC_DURING_TTS=false

# ---- Wake/VAD ----
WAKE_PHRASE=олег
WAKE_MATCH_THRESHOLD=0.60
WAKE_MIN_SPEECH_RATIO=0.10
WAKE_MIN_CONF=0.70
COMMAND_START_TIMEOUT_SEC=5.0

# ---- Barge-in (stop-word) ----
ENABLE_STOP_WORD=true
STOP_WORDS=стоп,хватит,отмена
STOP_WORD_COOLDOWN_SEC=1.0

# ---- Cloud reliability ----
CLOUD_MAX_IN_FLIGHT=2
CLOUD_MAX_ATTEMPTS=3
CLOUD_BASE_DELAY_SEC=0.4
CLOUD_MAX_DELAY_SEC=6.0

# ---- Weather skill ----
WEATHER_ENABLED=1
GEO_MODE=auto
# Recommended for a stationary Raspberry Pi: set your home coordinates.
# GEO_FIXED_LAT=56.8389
# GEO_FIXED_LON=60.6057
IP_GEO_URL=https://ipapi.co/json/
GEO_TIMEOUT_SEC=4.0
WEATHER_TIMEOUT_SEC=6.0
GEO_CACHE_TTL_SEC=43200
WEATHER_CACHE_TTL_SEC=300

# ---- Spotify ----
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:17845/callback
SPOTIFY_TOKEN_PATH=/opt/gpt-station/.secrets/spotify_tokens.json

# ---- Lights ----
LIGHTS_ENABLED=true
GAUSS_ADAPTER=wiz_lan
# WIZ_IPS=192.168.1.10,192.168.1.11

# ---- Logging ----
ASSISTANT_LOG_LEVEL=INFO
